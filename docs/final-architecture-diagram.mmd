    classDef mvc fill:#fdf2f0,stroke:#a52a1a,color:#2c1e16,stroke-width:2px;
    classDef application fill:#f8efe8,stroke:#8a3a2d,color:#2c1e16,stroke-width:2px;
    classDef access fill:#eef5ee,stroke:#52734d,color:#223322,stroke-width:2px;
    classDef persistence fill:#eef3f8,stroke:#486581,color:#1f2d3d,stroke-width:2px;
    classDef external fill:#f2eef8,stroke:#70518f,color:#2f2340,stroke-width:2px;
    class Blade,Frontend,MapUI,SupabaseJS presentation;
    class Routes,Requests,Controllers,Composer mvc;
    class Discovery,Parsers,ResponseGeneration,ProfileServices,CommunityServices,EngagementServices,SavedExperience application;
    class Contracts,Repositories access;
    class Models,Database persistence;
    class Auth,Storage,Tiles,AI,Mail external;
