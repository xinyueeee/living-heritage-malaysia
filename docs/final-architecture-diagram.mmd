flowchart TB
    User([Users / Web Browser])

    subgraph Presentation["PRESENTATION LAYER"]
        Blade["Blade layouts, pages, partials and components"]
        Frontend["Scoped CSS + JavaScript"]
        MapUI["Leaflet map UI"]
        SupabaseJS["Supabase Auth browser client"]
    end

    subgraph MVC["MVC REQUEST / CONTROLLER LAYER"]
        Routes["Laravel named routes + auth/guest middleware"]
        Requests["Form Requests\nDiscovery, assistant and profile inputs"]
        Controllers["Controllers\nExperience · Discovery Assistant · Profile\nCommunity · Engagement · Festival · Auth"]
        Composer["HeaderComposer"]
    end

    subgraph Application["BUSINESS / APPLICATION LAYER"]
        Discovery["Discovery services\nSearch/listing · Recommendations\nActivity tracking · Assistant/context"]
        Parsers["Intent parser abstraction\nRule-based + optional LLM + fallback"]
        ResponseGeneration["Grounded response generator abstraction\nOptional AI + deterministic fallback"]
        ProfileServices["ProfileService\nProfileAchievementsService"]
        CommunityServices["SavedPostService\nCommunityEngagementService"]
        EngagementServices["AchievementProgressService"]
        SavedExperience["SavedExperienceService"]
    end

    subgraph Access["DATA ACCESS LAYER"]
        Contracts["ExperienceRepositoryInterface\nDiscoveryActivityRepositoryInterface"]
        Repositories["EloquentExperienceRepository\nEloquentDiscoveryActivityRepository"]
    end

    subgraph Persistence["DOMAIN / PERSISTENCE"]
        Models["Eloquent models + relationships + casts\nExperience · Category · User · Post\nHistory · Notification · Rewards"]
    end

    Database[("PostgreSQL on Supabase\napplication tables")]

    subgraph External["INFRASTRUCTURE / EXTERNAL SERVICES"]
        Auth["Supabase Auth + JWKS"]
        Storage["Supabase Storage\nprofile and community images"]
        Tiles["OpenStreetMap tile service"]
        AI["Optional OpenAI-compatible AI endpoint"]
        Mail["Laravel Mail / Resend-compatible mail transport"]
    end

    User -->|HTTPS| Blade
    Blade <--> Frontend
    Frontend --> Routes
    Routes --> Requests
    Requests --> Controllers
    Routes --> Controllers
    Composer --> Blade
    Composer --> Models

    Controllers --> Discovery
    Controllers --> ProfileServices
    Controllers --> CommunityServices
    Controllers --> EngagementServices
    Controllers --> SavedExperience
    Discovery --> Parsers
    Discovery --> ResponseGeneration
    Discovery --> Contracts
    SavedExperience --> Contracts
    Contracts --> Repositories
    Repositories --> Models
    Models --> Database

    Controllers -. "remaining direct Eloquent / Query Builder\n(Profile, Community, Engagement, Festival)" .-> Models
    Controllers -. "auth and upload infrastructure\nnot yet fully service-wrapped" .-> Auth
    Controllers -.-> Storage
    SupabaseJS --> Auth
    Parsers -. "optional intent interpretation" .-> AI
    ResponseGeneration -. "database context only; deterministic fallback" .-> AI
    Frontend --> MapUI
    MapUI --> Tiles
    Controllers --> Mail

